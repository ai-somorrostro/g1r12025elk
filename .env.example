# ============================================================
# Variables de entorno para el stack ELK - VALORES DE EJEMPLO
# ============================================================
# Copiar este fichero a .env y rellenar con valores reales.
# NUNCA commitear el fichero .env al repositorio.
# ============================================================
 
# --- Elasticsearch ---
ES_PASSWORD=tu_contraseña_de_elastic_aqui
 
# --- Kibana ---
KIBANA_SERVICE_ACCOUNT_TOKEN=tu_service_account_token_aqui
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=clave_encriptacion_32_caracteres_1
KIBANA_REPORTING_ENCRYPTION_KEY=clave_encriptacion_32_caracteres_2
KIBANA_SECURITY_ENCRYPTION_KEY=clave_encriptacion_32_caracteres_3
CA_FINGERPRINT=fingerprint_del_certificado_ca
 
# --- Logstash ---
LOGSTASH_API_KEY=api_key_id:api_key_secret
 
# --- Metricbeat ---
# ES_PASSWORD se reutiliza para metricbeat → elasticsearch
KIBANA_SYSTEM_PASSWORD=contraseña_del_usuario_kibana_system
